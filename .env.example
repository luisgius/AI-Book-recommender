# LLM used for query understanding and grounded explanations (all optional).
#
# Recommended: OpenRouter with Qwen3.8 Flash, chosen against the other cheap
# candidates on the project's own tasks (data/evaluation/LLM_MODEL_SELECTION.md,
# 2026-11-11). One API key gives access to models of several families through
# the OpenAI-compatible API; local models were too slow for evaluation runs.
# Get a key at https://openrouter.ai/keys. No identifying headers are sent.
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen3.8-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here
# LLM_BASE_URL=https://openrouter.ai/api/v1   # default for openrouter
#
# Alternatives:
# - Local Ollama, no API key (the code default when LLM_PROVIDER is unset):
#     LLM_PROVIDER=ollama
#     LLM_MODEL=qwen3.8:27b-mlx
#     LLM_BASE_URL=http://127.0.0.1:11434
# - No LLM at all, plain hybrid search: LLM_PROVIDER=none
# - Other OpenRouter models tested with every structured output of the app:
#     deepseek/deepseek-v4.1-flash, minimax/minimax-m3.1-flash (LLM_REASONING=low),
#     z-ai/glm-5.3-flash and z-ai/glm-5.3 (LLM_REASONING=low),
#     google/gemini-3.8-flash (LLM_REASONING=low)
#
# LLM_TEMPERATURE=0.0
# LLM_NUM_CTX=8192               # Ollama only
# LLM_REASONING=false            # thinking mode (Ollama, OpenRouter): false
#                                # (default), true, default (model decides) or
#                                # an effort level: low, medium, high. Models
#                                # whose thinking cannot be switched off reject
#                                # false (OpenRouter returns HTTP 400): use low
#                                # for minimax/minimax-m3.1-flash, the z-ai/glm
#                                # models and google/gemini-3.8-flash.
# LLM_MAX_TOKENS=1024            # cap per call; stops runaway generations
# LLM_TIMEOUT_S=180
# LLM_MAX_RETRIES=1              # transient errors only
# LLM_MAX_EXPLANATIONS=3         # top results explained per search
# LLM_APPLY_CATEGORY_FILTER=false

# Estimated cost of the recorded LLM calls (optional, both or neither), in
# USD per million tokens of the model in use. No price is built into the code.
# Qwen3.8 Flash on OpenRouter, 2026-11-11:
# LLM_PRICE_INPUT_PER_MTOK=0.15
# LLM_PRICE_OUTPUT_PER_MTOK=0.47

# Direct hosted providers (set LLM_PROVIDER=openai or anthropic and the
# matching key). Default models: gpt-6-luna, claude-haiku-5-5.
# The Anthropic provider also needs: pip install langchain-anthropic
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM relevance judge (evaluation only: python -m app.evaluation.relevance_judge).
# Each value falls back to the LLM_* one, except the model on OpenRouter: the
# default judge there is z-ai/glm-5.3-flash, another vendor than the system
# LLM, as the literature recommends; it agreed best with the existing
# judgments (data/evaluation/LLM_MODEL_SELECTION.md). Temperature 0 and the
# token cap are fixed; thinking is off unless JUDGE_REASONING says otherwise
# (the default OpenRouter judge cannot switch it off and runs at low effort).
# JUDGE_PROVIDER=openrouter
# JUDGE_MODEL=z-ai/glm-5.3-flash
# JUDGE_REASONING=low
# JUDGE_BASE_URL=https://openrouter.ai/api/v1

# Embedding model for the vector (FAISS) side. The index in INDEXES_DIR must
# be built with the same model; the app refuses to load a mismatched index.
# Build one per model with:
#   python -m scripts.ingest_and_build --rebuild --embedding-model <model>
# (written to data/indexes_ablation/<model-slug>/ unless --out-dir is given)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DEVICE=mps           # cpu, mps or cuda; default: automatic

# Optional re-ranking stage: a cross-encoder re-orders the top RERANK_DEPTH
# fused results against the user's query. Disabled while RERANKER_MODEL is
# empty or unset (default). The model is downloaded and loaded on first search.
# Tested: BAAI/bge-reranker-v2-m3, cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_DEPTH=30
# RERANKER_DEVICE=mps            # cpu, mps or cuda; default: automatic

# MCP endpoint (/mcp): read-only tools search_books, get_book, similar_books
# for AI assistants. No LLM call and no authentication (public catalog data).
# By default it answers only requests addressed to this machine; a public
# deployment lists its hostname, e.g. MCP_ALLOWED_HOSTS=books.example.org
# ("*" turns the Host/Origin check off, only behind a proxy that sets Host).
# MCP_ENABLED=true
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
# MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
# MCP_RATE_LIMIT_PER_MINUTE=60   # per client address; 0 disables the limit
# MCP_MAX_RESPONSE_BYTES=40000   # largest JSON payload of one tool result

# Paths (defaults shown)
# DB_PATH=data/catalog.db
# INDEXES_DIR=data/indexes

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application Settings
ENVIRONMENT=development
