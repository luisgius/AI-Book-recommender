# LLM used for query understanding and grounded explanations (all optional).
#
# Recommended: OpenRouter with DeepSeek V4.1 Flash, chosen against the other
# cheap candidates on the project's own tasks with the speed-quality rule of
# 2026-11-11 (data/evaluation/LLM_MODEL_SELECTION.md): its citation precision
# ties with Qwen3.8 Flash (the earlier, quality-only choice) and it answers in
# 2.7 s per explanation instead of 6.6 s. One API key gives access to models
# of several families through the OpenAI-compatible API; local models were too
# slow for evaluation runs.
# Get a key at https://openrouter.ai/keys. No identifying headers are sent.
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here
# LLM_BASE_URL=https://openrouter.ai/api/v1   # default for openrouter
#
# Alternatives:
# - Local Ollama, no API key (the code default when LLM_PROVIDER is unset):
#     LLM_PROVIDER=ollama
#     LLM_MODEL=qwen3.8:27b-mlx
#     LLM_BASE_URL=http://127.0.0.1:11434
# - No LLM at all, plain hybrid search: LLM_PROVIDER=none
# - Other OpenRouter models tested with every structured output of the app:
#     qwen/qwen3.8-flash, minimax/minimax-m3.1-flash (LLM_REASONING=low),
#     z-ai/glm-5.3-flash and z-ai/glm-5.3 (LLM_REASONING=low),
#     google/gemini-3.8-flash (LLM_REASONING=low)
#
# LLM_TEMPERATURE=0.0
# LLM_NUM_CTX=8192               # Ollama only
# LLM_REASONING=false            # thinking mode (Ollama, OpenRouter): false
#                                # (default), true, default (model decides) or
#                                # an effort level: low, medium, high. Models
#                                # whose thinking cannot be switched off reject
#                                # false (OpenRouter returns HTTP 400): use low
#                                # for minimax/minimax-m3.1-flash, the z-ai/glm
#                                # models and google/gemini-3.8-flash.
# LLM_MAX_TOKENS=1024            # cap per call; stops runaway generations
# LLM_TIMEOUT_S=180
# LLM_MAX_RETRIES=1              # transient errors only
# LLM_MAX_EXPLANATIONS=3         # top results explained per search
# LLM_APPLY_CATEGORY_FILTER=false

# Estimated cost of the recorded LLM calls (optional, both or neither), in
# USD per million tokens of the model in use. No price is built into the code.
# DeepSeek V4.1 Flash on OpenRouter, list price of 2026-11-11 (the price paid
# depends on the endpoint OpenRouter routes to; V08 saw about 1.8 times this):
# LLM_PRICE_INPUT_PER_MTOK=0.051
# LLM_PRICE_OUTPUT_PER_MTOK=0.567
# (Qwen3.8 Flash, the V10 choice: 0.15 and 0.47.)

# Direct hosted providers (set LLM_PROVIDER=openai or anthropic and the
# matching key). Default models: gpt-6-luna, claude-haiku-5-5.
# The Anthropic provider also needs: pip install langchain-anthropic
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM relevance judge (evaluation only: python -m app.evaluation.relevance_judge).
# Each value falls back to the LLM_* one, except the model on OpenRouter: the
# default judge there is z-ai/glm-5.3-flash, another vendor than the system
# LLM, as the literature recommends; it agreed best with the existing
# judgments and the speed-quality rule of 2026-11-11 kept it (it ties with
# qwen/qwen3.8-flash and is cheaper; data/evaluation/LLM_MODEL_SELECTION.md). Temperature 0 and the
# token cap are fixed; thinking is off unless JUDGE_REASONING says otherwise
# (the default OpenRouter judge cannot switch it off and runs at low effort).
# JUDGE_PROVIDER=openrouter
# JUDGE_MODEL=z-ai/glm-5.3-flash
# JUDGE_REASONING=low
# JUDGE_BASE_URL=https://openrouter.ai/api/v1

# Embedding model for the vector (FAISS) side. The index in INDEXES_DIR must
# be built with the same model; the app refuses to load a mismatched index.
# Build one per model with:
#   python -m scripts.ingest_and_build --rebuild --embedding-model <model>
# (written to data/indexes_ablation/<model-slug>/ unless --out-dir is given)
# EMBEDDING_PROVIDER=local       # default: a sentence-transformers model in this process
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DEVICE=mps           # cpu, mps or cuda; default: automatic
# API embeddings (EMBEDDING_PROVIDER=openrouter) and their defaults in the
# cloud profile: see the cloud profile block below.

# Optional re-ranking stage: a cross-encoder re-orders the top RERANK_DEPTH
# fused results against the user's query. Disabled while RERANKER_MODEL is
# empty or unset (default). The model is downloaded and loaded on first search.
# Tested: BAAI/bge-reranker-v2-m3, cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# RERANKER_PROVIDER=local        # default: cross-encoder in this process
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_DEPTH=30
# RERANKER_DEVICE=mps            # cpu, mps or cuda; default: automatic
# The API reranker (RERANKER_PROVIDER=openrouter), on by default in the cloud
# profile: see the cloud profile block below.

# MCP endpoint (/mcp): read-only tools search_books, get_book, similar_books
# for AI assistants. No LLM call and no authentication (public catalog data).
# By default it answers only requests addressed to this machine; a public
# deployment lists its hostname, e.g. MCP_ALLOWED_HOSTS=books.example.org
# ("*" turns the Host/Origin check off, only behind a proxy that sets Host).
# MCP_ENABLED=true
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
# MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
# MCP_RATE_LIMIT_PER_MINUTE=60   # per client address; 0 disables the limit
# MCP_MAX_RESPONSE_BYTES=40000   # largest JSON payload of one tool result

# Paths (defaults shown)
# DB_PATH=data/catalog.db
# INDEXES_DIR=data/indexes

# ---------------------------------------------------------------------------
# Cloud profile: every variable of the deployed backend in one block.
# ---------------------------------------------------------------------------
# SEARCH_PROFILE=local (default) is the evaluated system: SQLite catalog and
# BM25/FAISS indexes on disk, models in this process. SEARCH_PROFILE=cloud
# serves the catalog, the lexical search (BM25 of Neon's lakebase_text) and the
# vector search (pgvector halfvec) from Postgres, and takes the query
# embedding and the re-ranking from OpenRouter's API, so the process loads no
# model (no torch, faiss, sentence-transformers or numpy: requirements-cloud.txt
# lists what it needs). The RRF fusion is the same SearchService in both.
#
# SEARCH_PROFILE=cloud
#
# Catalog: one Postgres schema per catalog, loaded with the same encoder the
# API uses (the loader reads the variables of this block):
#   SEARCH_PROFILE=cloud python -m scripts.load_postgres --from data/catalog.db --schema eval177_api
# The schema records the encoder identity (model, provider, dimension); the
# API refuses to search vectors of another one and serves lexical search only.
# DATABASE_SCHEMA=catalog
# PG_LEXICAL_RANKING=bm25        # bm25 (lakebase_text index) or ts_rank_cd
# PG_VECTOR_SEARCH=approximate   # approximate (ANN index) or exact (evaluation)
#
# Connection strings (Neon: written by `neon env pull`; never commit them).
# Pooled ("-pooler" host) for the API's queries; direct for migrations, bulk
# loads and index builds (falls back to DATABASE_URL when unset).
# DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
#
# OpenRouter key (OPENROUTER_API_KEY, above) for embeddings, reranker and LLM.
#
# Query and document embeddings. Defaults in the cloud profile: the choice of
# data/evaluation/API_MODELS.md (speed-quality rule, 2026-11-11):
# qwen/qwen3-embedding-8b cut to 1024 dimensions, pinned to DeepInfra (same
# nDCG@10 as the local multilingual-e5-large-instruct; 0.01 USD per million
# tokens). Providers return different vectors, hence the pin. Each variable
# overrides its default; another EMBEDDING_MODEL drops the dimension and the pin.
# EMBEDDING_PROVIDER=openrouter              # local would load the model here
# EMBEDDING_MODEL=qwen/qwen3-embedding-8b    # also measured: baai/bge-m3,
#                                            # intfloat/multilingual-e5-large, qwen/qwen3-embedding-4b
# EMBEDDING_DIMENSIONS=1024                  # Matryoshka models only (the Qwen3 embeddings)
# EMBEDDING_OPENROUTER_PROVIDER=deepinfra
#
# Re-ranking (on by default in the cloud profile): one OpenRouter rerank
# request per search with the top RERANK_DEPTH book texts (2,000 characters
# each): qwen/qwen3-reranker-8b on PrimeIntellect (bf16), about 0.6 s and
# 0.0015 USD per search. RERANKER_MODEL=none switches it off.
# RERANKER_PROVIDER=openrouter
# RERANKER_MODEL=qwen/qwen3-reranker-8b      # also measured: qwen/qwen3-reranker-0.6b
# RERANKER_OPENROUTER_PROVIDER=primeintellect
# RERANK_DEPTH=30
#
# LLM (query understanding, explanations, agent): no default changes with the
# profile. Use OpenRouter (LLM_PROVIDER=openrouter above) or none; the
# Ollama default needs a local server.
# LLM_PROVIDER=openrouter
#
# Spending since the process started (calls, tokens, latency and the cost the
# providers report, by operation) at GET /api/v1/usage; off by default (404).
# USAGE_ENDPOINT_ENABLED=false
#
# A public deployment lists its hostname for the MCP endpoint (see above):
# MCP_ALLOWED_HOSTS=books.example.org
#
# Integration tests against a real Postgres (skipped when unset); use a
# throwaway Neon branch:
# TEST_DATABASE_URL=...
# TEST_DATABASE_URL_UNPOOLED=...

# ---------------------------------------------------------------------------
# Public deployment (V17): guards against abuse and spending. All off by
# default (the local profile is unchanged); the Vercel deployment sets them.
# data/evaluation/DEPLOYMENT_CHECK.md lists the values deployed.
# ---------------------------------------------------------------------------
# Daily budget, counted per UTC day in a table of the database that every
# serverless instance shares (BUDGET_SCHEMA.daily_usage). Past
# DAILY_SEARCH_LIMIT a search runs lexical-only without re-ranking (no model
# call); past DAILY_LLM_LIMIT understanding and explanations are skipped with
# a notice and the agent answers 429. Unset: no limit.
# DAILY_SEARCH_LIMIT=400
# DAILY_LLM_LIMIT=60
# BUDGET_SCHEMA=usage_budget
#
# Per-client limits (sliding minute, counted in each instance's memory: not a
# hard ceiling on a serverless platform; the daily budget is). 0: no limit.
# CLIENT_IP_HEADER names the header a trusted proxy sets with the client's
# address (Vercel overwrites x-real-ip); it also feeds the MCP limit.
# SEARCH_RATE_LIMIT_PER_MINUTE=20
# LLM_RATE_LIMIT_PER_MINUTE=4
# CLIENT_IP_HEADER=x-real-ip
#
# Model API calls a user waits for (query embedding, re-ranking): one attempt,
# retries and a deadline for the whole call. Cloud defaults shown; outside the
# cloud profile the long document deadlines apply (30 s, 3 retries).
# API_QUERY_TIMEOUT_S=3
# API_QUERY_MAX_RETRIES=1
# API_QUERY_DEADLINE_S=5
#
# LLM calls: LLM_TIMEOUT_S and LLM_MAX_RETRIES (above) plus the provider
# client's own retries (the OpenAI client used for OpenRouter retries twice by
# default); 0 leaves LLM_MAX_RETRIES as the only retry.
# LLM_CLIENT_MAX_RETRIES=0
#
# POST /api/v1/evaluate runs the whole test collection: off in public (404).
# EVALUATE_ENDPOINT_ENABLED=false

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application Settings
ENVIRONMENT=development
